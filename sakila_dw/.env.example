# ============================================================
# sakila_dw Docker Environment Configuration
# 
# Copy this file to .env and customize the values:
#   cp .env.example .env
#
# These variables are used by docker-compose.yml
# ============================================================

# PostgreSQL Configuration (Data Warehouse)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=sakila_dw

# MySQL Configuration (Source Database)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=mysqlroot
MYSQL_USER=sakila
MYSQL_PASSWORD=sakila
MYSQL_DB=sakila

# Optional: ETL-specific configuration
ETL_BATCH_SIZE=10000
ETL_LOG_LEVEL=INFO

# Optional: Adminer (Database Management UI)
ADMINER_PORT=8080

# ============================================================
# Application Configuration
# ============================================================

# These are used by the Python application (via python-dotenv)
# They should match the Docker configuration above

# PostgreSQL (Warehouse)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=sakila_dw

# MySQL (Source)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sakila
MYSQL_PASSWORD=sakila
MYSQL_DB=sakila
